# ========================================
# LLMO Platform - 環境変数設定
# ========================================
# このファイルを .env.local にコピーして設定してください
# cp .env.example .env.local

# ----------------------------------------
# データベース (PostgreSQL)
# ----------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/llmo_platform"

# ----------------------------------------
# NextAuth.js 認証
# ----------------------------------------
NEXTAUTH_SECRET="your-secret-here-change-this"
NEXTAUTH_URL="http://localhost:3000"

# ----------------------------------------
# AI プロバイダー API キー
# ----------------------------------------

# Google Gemini (必須 - Phase 1)
GEMINI_API_KEY="AIza..."

# OpenAI / ChatGPT (Phase 2 で追加)
# OPENAI_API_KEY="sk-..."

# Perplexity AI (Phase 2 で追加)
# PERPLEXITY_API_KEY="pplx-..."
